# Kopier til scripts/ai-lab.env.local. Denne eksempel-fila inneheld ingen nøkkel.
NODE_ENV=development
AI_LAB_ENABLED=true
AI_LAB_PORT=8080
# Lag en tilfeldig token på minst 32 tegn. Ikke commit den faktiske verdien.
AI_LAB_ACCESS_TOKEN=
AI_LAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_LAB_OLLAMA_MODEL=gemma4:26b
AI_LAB_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_LAB_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# Må bare settes til true etter at konto/avtale, tillatte datakategorier,
# retensjon og ekstern behandling er eksplisitt godkjent internt.
AI_LAB_ANTHROPIC_PROCESSING_APPROVED=false
AI_LAB_TIMEOUT_MS=120000
AI_LAB_ANTHROPIC_CALLS_PER_HOUR=10
AI_LAB_MAX_PROMPT_CHARS=200000
AI_LAB_SNAPSHOT_TTL_MS=1800000
# Offentlig control-plane-konfig for serververifisering av superadmin-JWT.
# Standardverdiene peker på Vibeverks control-plane og kan vanligvis utelates.
ARCTIC_CONTROL_URL=https://jxoglthrnshabqmdmnui.supabase.co
ARCTIC_CONTROL_ANON_KEY=
# Valgfri, eksakt produksjonsorigin som får bruke den lokale browser-broen.
# Broen er fortsatt bundet til 127.0.0.1 og krever lokal token + superadmin-JWT.
ARCTIC_BRIDGE_ALLOWED_ORIGIN=https://vibeverk.no
# Lokal, gitignorert katalog for metadata-only kommandorevisjon.
ARCTIC_RUNTIME_DIR=.runtime/arctic
